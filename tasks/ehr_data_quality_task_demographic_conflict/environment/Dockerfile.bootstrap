FROM python:3.12-slim

# Bootstrap image: runs the corruption pipeline (stage_data.py / inject.py)
# once per trial and exits. It is the ONLY image that carries the pinned
# scientific stack; the agent's image (Dockerfile) ships no third-party
# packages. The pins matter: labels.csv was generated with these exact
# versions and bootstrap.sh's --verify-against check must reproduce it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bash ca-certificates curl wget util-linux \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir pandas==3.0.1 pyarrow==23.0.1 duckdb==1.5.2 numpy==2.4.2 pyyaml==6.0.3

ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /workspace
RUN mkdir -p /workspace/data
